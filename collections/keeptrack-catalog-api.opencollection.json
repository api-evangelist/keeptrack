{
  "opencollection": "1.0.0",
  "info": {
    "name": "KeepTrack Space Catalog API",
    "version": "4.2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List the satellite catalog with pagination",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.keeptrack.space/v4/catalog",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List the satellite catalog with pagination"
        }
      ]
    }
  ],
  "bundled": true
}